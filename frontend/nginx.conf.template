server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;

    location = /health {
        access_log off;
        default_type application/json;
        return 200 '{"status":"ok","service":"plugin-whitelabel-frontend"}';
    }

    location /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass ${APP_API_1_URL};
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_ssl_name ${APP_API_1_HOST};
        proxy_set_header Host ${APP_API_1_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
# __API_PRIMARY_FAILOVER__
    }

# __API_FAILOVER_LOCATION__

    # Only the browser-facing management API is proxied under /backend. Every
    # other /backend path is denied. The public resolver has one separate exact
    # route so production can fail over between two independent API hosts.
    location ^~ /backend/api/ {
        rewrite ^/backend/(.*)$ /$1 break;
        proxy_pass ${APP_BACKEND_1_URL};
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_ssl_name ${APP_BACKEND_1_HOST};
        proxy_set_header Host ${APP_BACKEND_1_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
# __BACKEND_PRIMARY_FAILOVER__
    }

    # Unity uses the same stable public origin as the management frontend. Only
    # this exact unauthenticated resolver path is forwarded to the plugin API.
    location = /v1/white-label-configs {
        proxy_pass ${APP_BACKEND_1_URL};
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_ssl_name ${APP_BACKEND_1_HOST};
        proxy_set_header Host ${APP_BACKEND_1_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
# __BACKEND_PRIMARY_FAILOVER__
    }

# __BACKEND_FAILOVER_LOCATION__

    location ^~ /backend/ {
        return 404;
    }

    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
