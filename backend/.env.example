NODE_ENV=development
PORT=8093

DB_HOST=127.0.0.1
DB_PORT=3337
DB_NAME=whitelabel
DB_USER=whitelabel
DB_PASSWORD=change-me
DB_CONNECTION_LIMIT=10

# A fixed service-owned base URL. The backend appends /v1/plugin/verify-token.
# It is never derived from request headers, query parameters, or JWT claims.
MAIN_API_BASE_URL=http://localhost:8081
MAIN_API_TIMEOUT_MS=5000

# Optional fixed main-frontend origin used only for the root-only import catalog.
MAIN_FRONTEND_PUBLIC_BASE_URL=http://localhost:3001
DOMAIN_CATALOG_TIMEOUT_MS=3000
