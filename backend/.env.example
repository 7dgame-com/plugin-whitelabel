NODE_ENV=development
PORT=8093

DB_HOST=127.0.0.1
DB_PORT=3337
DB_NAME=whitelabel
DB_USER=whitelabel
DB_PASSWORD=change-me
DB_CONNECTION_LIMIT=10

# A fixed service-owned base URL. The backend appends /v1/plugin/verify-token.
# It is never derived from request headers, query parameters, or JWT claims.
MAIN_API_BASE_URL=http://localhost:8081
MAIN_API_TIMEOUT_MS=5000

# Public yii3-a1 origin/base path used to build assignment QR URLs.
# Production startup rejects plain HTTP.
A1_PUBLIC_BASE_URL=http://localhost:8888

# Generate a random value of at least 32 characters and share it only with yii3-a1.
WHITELABEL_INTERNAL_TOKEN=replace-with-at-least-32-random-characters
