# Local orchestration only. Never commit real credentials.
WHITELABEL_DB_ROOT_PASSWORD=local-root-password
WHITELABEL_DB_NAME=whitelabel
WHITELABEL_DB_USER=whitelabel
WHITELABEL_DB_PASSWORD=local-whitelabel-password
WHITELABEL_INTERNAL_TOKEN=replace-with-a-long-random-value

DB_HOST=127.0.0.1
DB_PORT=3337
DB_NAME=whitelabel
DB_USER=whitelabel
DB_PASSWORD=local-whitelabel-password
DB_CONNECTION_LIMIT=10

MAIN_API_BASE_URL=http://localhost:8081
MAIN_API_DOCKER_BASE_URL=http://host.docker.internal:8081
MAIN_API_TIMEOUT_MS=5000
# Optional root-only import source. Leave both values empty to disable import.
# The backend reads only this origin's fixed /config/domains/manifest.json path;
# saved snapshots never stay synchronized.
MAIN_FRONTEND_PUBLIC_BASE_URL=http://localhost:3001
MAIN_FRONTEND_DOCKER_PUBLIC_BASE_URL=http://host.docker.internal:3001
DOMAIN_CATALOG_TIMEOUT_MS=3000
A1_PUBLIC_BASE_URL=http://localhost:8888
